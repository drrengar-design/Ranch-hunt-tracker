# Site-entry PIN (client-side). Default is 1808 if unset.
# This is separate from the Admin PIN (stored in app data; default 1234)
# and from the ranch sync secret.
VITE_SITE_PIN=1808

# Optional: bake the ranch sync secret into the client bundle.
# Prefer setting RANCH_SYNC_SECRET on the Netlify site (server) and either:
#   - also set VITE_RANCH_SYNC_SECRET to the same value (rebuild required), or
#   - leave this unset and enter the secret once in Settings (stored in localStorage).
# If both are unset, the client defaults to 1808 (same digits as the site code,
# but a different setting — change them independently in production).
# VITE_RANCH_SYNC_SECRET=1808

# Server-only (Netlify UI / CLI, NOT VITE_):
# RANCH_SYNC_SECRET=your-ranch-secret
